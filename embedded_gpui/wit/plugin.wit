package gpui:embedded;

/// An experimental protocol for running GPUI itself inside a Wasm guest ("plugin") whose
/// rendered output is embedded into a host GPUI application.
///
/// The host never blocks a frame on the guest. The guest renders asynchronously into a
/// retained display list, which the host caches and replays each frame.
///
/// Coordinates: all geometry in this protocol is in *logical pixels* (already divided by the
/// scale factor), relative to the origin of the plugin view's slot in the host window.
world plugin {
    // ------------------------------------------------------------------
    // Geometry & color
    // ------------------------------------------------------------------

    record point {
        x: f32,
        y: f32,
    }

    record extent {
        width: f32,
        height: f32,
    }

    record bounds {
        origin: point,
        size: extent,
    }

    record hsla {
        h: f32,
        s: f32,
        l: f32,
        a: f32,
    }

    record corners {
        top-left: f32,
        top-right: f32,
        bottom-right: f32,
        bottom-left: f32,
    }

    record edges {
        top: f32,
        right: f32,
        bottom: f32,
        left: f32,
    }

    // ------------------------------------------------------------------
    // Display list
    // ------------------------------------------------------------------

    enum border-style {
        solid,
        dashed,
    }

    record quad {
        bounds: bounds,
        content-mask: bounds,
        background: hsla,
        border-color: hsla,
        corner-radii: corners,
        border-widths: edges,
        border-style: border-style,
    }

    record shadow {
        /// Bounds of the element casting the shadow (not the blurred region).
        bounds: bounds,
        content-mask: bounds,
        corner-radii: corners,
        color: hsla,
        blur-radius: f32,
        spread-radius: f32,
        offset: point,
    }

    record underline {
        origin: point,
        width: f32,
        content-mask: bounds,
        color: hsla,
        thickness: f32,
        wavy: bool,
    }

    /// A glyph to be rasterized and painted by the host. `origin` is the glyph's baseline
    /// origin in logical pixels, exactly as accepted by GPUI's `Window::paint_glyph`.
    record glyph {
        font-id: u32,
        glyph-id: u32,
        origin: point,
        font-size: f32,
        color: hsla,
        content-mask: bounds,
        is-emoji: bool,
    }

    /// One triangle-list vertex of a tessellated path, as produced by GPUI's tessellator.
    record path-vertex {
        /// Position in logical pixels, relative to the view origin.
        xy: point,
        /// Barycentric-style texture coordinates used for antialiasing.
        st: point,
    }

    record path {
        content-mask: bounds,
        color: hsla,
        /// A triangle list; length is always a multiple of three.
        vertices: list<path-vertex>,
    }

    /// A bitmap to paint. The pixel data travels separately (and only once) in
    /// `display-list.new-images`, keyed by `image-id`.
    record image {
        image-id: u64,
        bounds: bounds,
        content-mask: bounds,
        corner-radii: corners,
        grayscale: bool,
        opacity: f32,
    }

    variant primitive {
        quad(quad),
        shadow(shadow),
        underline(underline),
        glyph(glyph),
        path(path),
        image(image),
    }

    /// A primitive plus the draw order it had in the guest scene. Primitives with the same
    /// order value belong to the same stacking layer; the host must preserve the relative
    /// ordering of the `order` values when replaying.
    record placed-primitive {
        order: u32,
        prim: primitive,
    }

    /// Pixel data for an image the host has not seen yet. Bytes are BGRA8 with
    /// premultiplied alpha, matching GPUI's `RenderImage` frame layout, sized in device
    /// pixels (already rasterized at the view's scale factor).
    record image-payload {
        id: u64,
        width: u32,
        height: u32,
        bytes: list<u8>,
    }

    record display-list {
        primitives: list<placed-primitive>,
        new-images: list<image-payload>,
    }

    // ------------------------------------------------------------------
    // Text (guest -> host; the host does all shaping and rasterization)
    // ------------------------------------------------------------------

    record font-descriptor {
        family: string,
        /// CSS-style weight, 100.0 ..= 900.0.
        weight: f32,
        italic: bool,
    }

    record font-metrics {
        units-per-em: u32,
        ascent: f32,
        descent: f32,
        line-gap: f32,
        underline-position: f32,
        underline-thickness: f32,
        cap-height: f32,
        x-height: f32,
        bounding-box: bounds,
    }

    record font-run {
        /// Length of this run in UTF-8 bytes.
        len: u32,
        font-id: u32,
    }

    record shaped-glyph {
        id: u32,
        position: point,
        /// UTF-8 byte index of this glyph in the line's text.
        index: u32,
        is-emoji: bool,
    }

    record shaped-run {
        font-id: u32,
        glyphs: list<shaped-glyph>,
    }

    record line-layout {
        font-size: f32,
        width: f32,
        ascent: f32,
        descent: f32,
        /// Length of the line in UTF-8 bytes.
        len: u32,
        runs: list<shaped-run>,
    }

    /// Cache key for glyph raster bounds. Mirrors GPUI's `RenderGlyphParams`.
    record glyph-params {
        font-id: u32,
        glyph-id: u32,
        font-size: f32,
        subpixel-variant-x: u8,
        subpixel-variant-y: u8,
        scale-factor: f32,
        is-emoji: bool,
    }

    /// Bounds in device pixels (i32), as returned by the host's glyph rasterizer.
    record device-bounds {
        origin-x: s32,
        origin-y: s32,
        width: s32,
        height: s32,
    }

    import resolve-font: func(font: font-descriptor) -> u32;
    // Named `font-metrics-for` because WIT functions and types share one namespace, so this
    // import cannot reuse the `font-metrics` record name.
    import font-metrics-for: func(font-id: u32) -> font-metrics;
    import layout-line: func(text: string, font-size: f32, runs: list<font-run>) -> line-layout;
    import advance: func(font-id: u32, glyph-id: u32) -> extent;
    import typographic-bounds: func(font-id: u32, glyph-id: u32) -> bounds;
    import glyph-for-char: func(font-id: u32, ch: char) -> option<u32>;
    import glyph-raster-bounds: func(params: glyph-params) -> device-bounds;

    // ------------------------------------------------------------------
    // Objects
    //
    // A symmetric object channel. Each end owns *local* objects (homes: entities whose
    // state lives here and whose methods answer calls) and holds *remotes* to the other
    // end's objects. The protocol has no notion of host or guest -- both ends run the
    // same registry -- and no names: objects are addressed only by id, and new objects
    // are discovered as refs inside payloads.
    //
    // Ids are random, nonzero u64s minted by whichever end homes the object, so a ref
    // is universally applicable: nothing is namespaced per end, and an id can only be
    // *known*, never guessed or enumerated -- holding a ref is the authority. The single
    // reserved value is 0, "your root": a connection-local *address*, never an identity
    // in a payload. Each end installs one root object, and the exchange of the two roots
    // is the entire bootstrap -- everything else is reached by calling root methods that
    // return refs.
    //
    // Refs travel in a per-frame *table*: payload bytes name a ref by its index into
    // `refs`, never by id. That keeps payloads opaque to the registry while making every
    // ref in transit enumerable, so a forwarder (caretaker, membrane, auditor) can
    // rewrite the table without parsing the payload. Everything that has UI meaning --
    // surfaces, views, input, cursors -- is an object with methods, defined in the
    // `embedded_gpui` crate as schemas, not here.
    //
    // Events are not a channel: they are calls flowing the other way. A remote that
    // wants the home's `cx.notify` / `cx.emit` sends a `subscribe` frame carrying a ref
    // to an *observer object* on its own end; the home then calls that observer with
    // ordinary calls. A `release` frame tells a home its last remote dropped.
    // ------------------------------------------------------------------

    /// A dynamically dispatched call to an object's home end. A call with a `request`
    /// id expects a `response` frame. FIFO delivery is the consistency story: a read
    /// issued after a write is itself a call, so it observes the write.
    record call {
        target: u64,
        request: option<u64>,
        method: string,
        payload: list<u8>,
        /// The refs the payload mentions, by index.
        refs: list<u64>,
    }

    /// The answer to a `call` that carried a `request` id.
    record response {
        request: u64,
        outcome: result<list<u8>, string>,
        /// The refs a successful outcome mentions, by index.
        refs: list<u64>,
    }

    /// Register an observer object with an entity's home: the home will call it with
    /// notifies and typed events, starting with one initial notify.
    record subscribe {
        target: u64,
        observer: u64,
    }

    /// The sender's last remote for this object dropped: the home lets go of its strong
    /// handle and forgets its observers.
    record release {
        target: u64,
    }

    /// Everything that crosses the boundary about objects. Both directions carry one
    /// FIFO list of these per turn, so calls, responses, subscriptions, and releases
    /// order with each other.
    variant frame {
        call(call),
        response(response),
        subscribe(subscribe),
        release(release),
    }

    // ------------------------------------------------------------------
    // Turns
    //
    // The whole runtime protocol is two exports. The host never blocks on the guest and
    // the guest never calls back into the host except for synchronous text shaping
    // (layout needs the answer mid-call), so re-entrancy is impossible by construction
    // rather than by rule.
    // ------------------------------------------------------------------

    /// A freshly rendered display list for a surface object (a host-homed `SurfaceApi`
    /// entity, identified by its object id). The host caches it and repaints.
    record scene {
        surface: u64,
        %list: display-list,
    }

    /// Everything the guest produced during one turn.
    record turn {
        /// Object traffic toward the host, in send order.
        frames: list<frame>,
        scenes: list<scene>,
        /// Ask the host to tick again after at least this many milliseconds (zero: as
        /// soon as possible). Absent when the guest has no pending timers.
        wake-after-ms: option<u32>,
    }

    /// Construct the guest's GPUI app and run `Plugin::new`. The component installs its
    /// root object here and may immediately message the host's root (address 0); each
    /// end queues root-addressed traffic until its own root exists, so the two bootstraps
    /// may race freely. Whatever `init` queued is collected by the first `tick`.
    export init: func();

    /// One guest turn: deliver `inbound` to the registry in order, run due timers and
    /// queued runnables, let dirty windows redraw, and return everything that produced.
    export tick: func(inbound: list<frame>) -> turn;
}
